# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Use the "pooled"/"transaction mode" connection string if your provider offers one —
# serverless functions on Vercel open a new connection per invocation.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session cookies. Generate a strong value with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Google sign-in (optional). Create an OAuth client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this authorized redirect URI
# for every place the app runs, e.g.:
#   http://localhost:3001/api/auth/google/callback
#   https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Push reminders (optional). Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL or mailto: sent to push services. Must not point at localhost.
VAPID_SUBJECT="https://officetimetracker.vercel.app"
# Shared secret for the reminder scheduler (.github/workflows/reminders.yml). Any long random string.
CRON_SECRET=""

# Public URL used in emailed links (password reset). Recommended in production.
APP_URL="https://officetimetracker.vercel.app"

# Email for "Forgot password?" (optional). Any SMTP provider works. For Gmail, turn on 2-Step
# Verification and create an App Password at https://myaccount.google.com/apppasswords.
# Without these, reset links are printed to the dev server console (development only).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
