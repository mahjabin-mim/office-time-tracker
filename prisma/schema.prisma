generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String? // null for accounts that only sign in with Google
  googleId       String?  @unique
  timeFormat     String   @default("12h") // "12h" | "24h"
  theme          String   @default("system") // "light" | "dark" | "system"
  timezone       String? // IANA zone detected from the browser, e.g. "Asia/Dhaka"
  remindClockIn  Boolean  @default(false)
  remindLeave    Boolean  @default(true)
  remindClockOut Boolean  @default(true)
  /// Stamped into session cookies; bumping it signs the user out on every device.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances       Attendance[]
  schedule          WorkSchedule?
  pushSubscriptions PushSubscription[]
  reminderLogs      ReminderLog[]
  passwordResets    PasswordResetToken[]
}

model WorkSchedule {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedDailyMinutes Int      @default(540)
  breakMinutes         Int      @default(60)
  halfDayMinutes       Int      @default(270)
  workStartMinutes     Int      @default(540)
  workEndMinutes       Int      @default(1140)
  workingDays          String   @default("0,1,2,3,4")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Attendance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime // the calendar day, stored as UTC midnight
  entryMinutes Int?
  outMinutes   Int?
  isHalfDay    Boolean  @default(false)
  leaveType    String? // "leave" | "sick" | "holiday"; times are ignored when set
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per reminder sent, so each kind fires at most once per user per day.
model ReminderLog {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey String // YYYY-MM-DD in the user's time zone
  kind    String // "clock-in" | "leave" | "clock-out"
  sentAt  DateTime @default(now())

  @@unique([userId, dateKey, kind])
}

/// Single-use "forgot password" links. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Failed password logins, used to slow down password guessing. Pruned after a day.
/// Not linked to User: attempts for emails without an account are limited too.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
